	partition Calendar_Payment = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDARAUTO(),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "YearMonth", FORMAT([Date], "YYYYMM"),
				    "MonthNumber", MONTH([Date]),
				    "MonthName", FORMAT([Date], "MMMM"),
				    "Day", DAY([Date])
				)
				
				```

	annotation PBI_Id = 1ccf32ecd69c4677a3b9083d29761300

