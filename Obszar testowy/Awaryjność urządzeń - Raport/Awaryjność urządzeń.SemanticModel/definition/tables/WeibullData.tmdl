	column Base_GroupB
		lineageTag: 08da7d4a-f35b-478f-a91b-775bb3d67851
		summarizeBy: none
		isNameInferred
		sourceColumn: [Base_GroupB]

		annotation SummarizationSetBy = Automatic

	partition WeibullData = calculated
		mode: import
		source = ```
				
				VAR Base =
				    FILTER (
				        SELECTCOLUMNS (
				            'Fact_Items_Failure',
				            "Base_GroupB", 'Fact_Items_Failure'[Base_GroupB],
				            "Item_No_Serviced", 'Fact_Items_Failure'[Item_No_Serviced],
				            "Firma", 'Fact_Items_Failure'[Firma],
				            "T", 'Fact_Items_Failure'[Time_To_Failure (month)]
				        ),
				        NOT ISBLANK ( [T] ) && [T] > 0
				    )
				VAR WithRanks =
				    ADDCOLUMNS (
				        Base,
				        "n",
				            VAR gNo = [Base_GroupB]
				            VAR gItem = [Item_No_Serviced]
				            RETURN COUNTROWS ( FILTER ( Base, [Base_GroupB] = gNo && [Item_No_Serviced] = gItem ) ),
				        "r",
				            VAR gNo2 = [Base_GroupB]
				            VAR gItem2 = [Item_No_Serviced]
				            RETURN
				                RANKX (
				                    FILTER ( Base, [Base_GroupB] = gNo2 && [Item_No_Serviced] = gItem2 ),
				                    [T],
				                    ,
				                    ASC,
				                    Dense
				                )
				    )
				VAR Step1 =
				    ADDCOLUMNS (
				        WithRanks,
				        "F", DIVIDE ( [r], [n] + 1 ),
				        "X", LN ( [T] )
				    )
				VAR Step2 =
				    ADDCOLUMNS (
				        Step1,
				        "Y", LN ( - LN ( 1 - [F] ) )
				    )
				RETURN
				    SELECTCOLUMNS (
				        Step2,
				        "Base_GroupB", [Base_GroupB],
				        "Item_No_Serviced", [Item_No_Serviced],
				        "Firma", [Firma],
				        "T", [T],
				        "n", [n],
				        "r", [r],
				        "F", [F],
				        "X", [X],
				        "Y", [Y]
				    )
				
				```

	annotation PBI_Id = ebfec181637a49dca219921120d303f8

