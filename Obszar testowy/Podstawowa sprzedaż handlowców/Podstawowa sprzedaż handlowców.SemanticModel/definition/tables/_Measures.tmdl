			    CALCULATE(
			        SUM('invoices'[AmountLCY]),
			        FILTER(
			            ALL('Calendar'),
			            AND(Calendar[Year] = PrevYear,
			                Calendar[MonthNumber] = CurrentMonth
			            )   
			        )
			    )
			
			VAR DistinctInvoiceCountCurrentMonth =
			    CALCULATE(
			        DISTINCTCOUNT( 'invoices'[KeyNoInvoice] ),
			        FILTER(
			            ALL('Calendar'),
			            AND(Calendar[Year] = PrevYear,
			                Calendar[MonthNumber] = CurrentMonth
			            )
			        )
			    )
			
			RETURN
