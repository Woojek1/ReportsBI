	measure OverdueAmountLCYTotal =
			
			CALCULATE(
			    SUMX(
			        FILTER(
			            SUMMARIZE(
			                ALL('invoices'),
			                'invoices'[KeyNoInvoice],
			                "DueDate",   MAX('invoices'[DueDate]),
			                "RemAmount", MAX('invoices'[RemainingAmountLCY])
			            ),
			            [DueDate] < TODAY()
			        ),
			        [RemAmount]
			    ),
			    all(),
			    KEEPFILTERS(VALUES('gold v_bc_salesperson'[Code]))
			)
		formatString: #,0
		displayFolder: Sales
		lineageTag: 897ab103-5690-48ce-9654-2966d8f0d32f

		annotation PBI_FormatHint = {"isDecimal":true}

	measure OverdueInvoicesCount = ```
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('invoices'[KeyNoInvoice]),
			        'invoices'[DueDate] < TODAY(),
			        'invoices'[RemainingAmountLCY] > 0
			    ),
			    0
			)
			
			```
		formatString: #,0
		displayFolder: Sales
		lineageTag: b3e5ba7f-ffdb-49f4-ae4c-f900e915efc1

