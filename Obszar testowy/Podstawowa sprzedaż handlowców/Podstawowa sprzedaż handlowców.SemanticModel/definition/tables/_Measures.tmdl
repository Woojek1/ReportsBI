	measure MarginItems = ```
			
			VAR _SalesAmountLCY = 
			                    CALCULATE(
			                        SUM(Invoices[AmountLCY]),
			                        Invoices[Type] = "Item" ||
			                        Invoices[Type] = "Charge (Item)"
			                        )
			                    
			                
			
			VAR _ProfitLCY = 
			            CALCULATE(
			                SUM(Invoices[ProfitLCY]),
			                        Invoices[Type] = "Item" ||
			                        Invoices[Type] = "Charge (Item)"
			            )            
			
			VAR Margin = 
			        DIVIDE(_ProfitLCY, _SalesAmountLCY)
			
			
			RETURN Margin
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Sales
		lineageTag: 78e4d0d7-dcc3-465f-868a-ae92faf3cabc

	measure MarginItems_MTD_Today = ```
			
			VAR _SalesAmountLCY = 
			                    CALCULATE(
			                        TOTALMTD(
			                            SUM('invoices'[AmountLCY]),
			                            'Calendar'[Date]
			                        ),
			                        'Calendar'[Date] = TODAY(),
			                        'invoices'[Type] = "Item" || 'invoices'[Type] = "Charge (Item)"
			    )
			
			VAR _Costs = 
			            CALCULATE(
			                TOTALMTD(
			                    SUM('Invoices'[Koszt skorygowany]),
			                    'Calendar'[Date]
			                ),
			                'Calendar'[Date] = TODAY(),
			                'invoices'[Type] = "Item" || 'invoices'[Type] = "Charge (Item)"
			            )
			
			
			VAR _ProfitLCY = 
			            _SalesAmountLCY - _Costs   
			
			RETURN
			    DIVIDE(
			            _ProfitLCY,
			            _SalesAmountLCY
			    )
			
			
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Sales
		lineageTag: 539626a7-4335-4770-912e-4baf3eacc858

