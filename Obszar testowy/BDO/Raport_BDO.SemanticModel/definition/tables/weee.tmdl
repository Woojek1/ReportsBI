	column 'Quarter Label' = ```
			
			  YEAR(weee[quarter]) & " Q" &
			  INT( (MONTH(weee[quarter]) - 1) / 3 ) + 1
			
			```
		lineageTag: a7a7a827-9953-484a-88e7-cad02a140407
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition weee = m
		mode: directQuery
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("10.0.13.24", "dwh"), "SELECT#(lf)  company,#(lf)  date_trunc('quarter', posting_date)::date AS quarter,#(lf)  category_code,#(lf)  fee_mode,#(lf)  SUM(qty_base) AS units,#(lf)  ROUND(SUM(kg), 3) AS kg,#(lf)  ROUND(SUM(amount), 2) AS amount_lcy#(lf)FROM gold.v_weee_domestic_with_amount#(lf)GROUP BY company, date_trunc('quarter', posting_date), category_code, fee_mode#(lf)ORDER BY company, quarter, category_code#(lf)", null, [EnableFolding=true])
				in
				    Source

	changedProperty = Name

	annotation PBI_ResultType = Table

