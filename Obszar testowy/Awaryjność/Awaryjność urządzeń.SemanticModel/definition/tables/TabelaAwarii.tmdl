	column Failure_Rank
		formatString: 0
		lineageTag: 702ad587-8af1-4f47-a0db-c51d30dbd288
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Failure_Rank]

		annotation SummarizationSetBy = Automatic

	partition TabelaAwarii = calculated
		mode: import
		source = ```
				
				SELECTCOLUMNS(
				    ADDCOLUMNS(
				        'gold Fact_Items_Failure',
				        "Failure_Rank",
				            ROWNUMBER(
				                PARTITIONBY('gold Fact_Items_Failure'[Item_No_Serviced]),
				                ORDERBY(
				                    'gold Fact_Items_Failure'[Failure_Date], ASC,
				                    'gold Fact_Items_Failure'[Serial_No_Serviced], ASC   -- tie-breaker
				                ),
				                SKIP
				            )
				    ),
				    "Item_No_Serviced", [Item_No_Serviced],
				    "Failure_Date", [Failure_Date],
				    "Sale_Date", [Sale_Date],
				    "Time_To_Failure (month)", [Time_To_Failure (month)],
				    "Serial_No_Serviced", [Serial_No_Serviced],
				    "Failure_Rank", [Failure_Rank]
				)
				
				```

	annotation PBI_Id = c6b1c9fcb84b4310a0d81f4f531f5861

