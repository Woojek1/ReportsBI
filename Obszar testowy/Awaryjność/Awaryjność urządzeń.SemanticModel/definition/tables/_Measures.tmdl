table _Measures
	lineageTag: f3e0bbd7-45b6-4400-b608-03c1f42e80d8

	measure Failure_Ratio = ```
			
			DIVIDE(
			    COUNTROWS ( RELATEDTABLE ( 'gold Fact_Items_Failure' ) ),
			    SUM ( 'gold Dim_BC_NAV_Sold_Items_Aggregation'[Quantity] )
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
