table 'gold zapotrzebowanie_na_czesci'
	lineageTag: 63e5b239-bd95-4d13-925d-7fafb211869d

	measure Awaryjność = ```
			
			
			    SUM('gold zapotrzebowanie_na_czesci'[Ilosc_awarii])/SUM('gold zapotrzebowanie_na_czesci'[Sold_quantity])
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5077f386-0293-4764-bbe1-00baa2a64887

	measure 'Prawdopodobieństwo awarii' = ```
			
			VAR beta = max('gold zapotrzebowanie_na_czesci'[a (wsp. kierunkowy)])
			VAR eta =
			    MAXX(
			        'gold zapotrzebowanie_na_czesci',
			        EXP( - 'gold zapotrzebowanie_na_czesci'[b (wyraz wolny)] /max('gold zapotrzebowanie_na_czesci'[a (wsp. kierunkowy)])
			    ))
			    
			
			RETURN
			
			1 - EXP(
			    - POWER(
			        SELECTEDVALUE(Miesiace[Miesiace]) / eta,
			        beta
			    )
			)
			```
		lineageTag: 147c259e-9bde-4b1b-ba19-551eea0b2656

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Zapotrzebowanie na częsci' = ```
			
			VAR beta = max('gold zapotrzebowanie_na_czesci'[a (wsp. kierunkowy)])
			VAR eta =
			    MAXX(
			        'gold zapotrzebowanie_na_czesci',
			        EXP( - 'gold zapotrzebowanie_na_czesci'[b (wyraz wolny)] /max('gold zapotrzebowanie_na_czesci'[a (wsp. kierunkowy)])
			    ))
			    
			RETURN
			
			(1 - EXP(
			    - POWER(
			        SELECTEDVALUE(Miesiace[Miesiace])
			         / eta,
			        beta
			    )
			))
			*
			[Awaryjność]
			*
			MAX('gold zapotrzebowanie_na_czesci'[Sold_quantity])
			```
		lineageTag: 92b7d3a6-445d-4ad9-a679-3e347be9d3bb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prawdopodobieństwo awarii2' =
			
			
			VAR beta = MAX('gold zapotrzebowanie_na_czesci'[a (wsp. kierunkowy)])
			VAR b    = MAX('gold zapotrzebowanie_na_czesci'[b (wyraz wolny)])
			VAR eta  = EXP( - DIVIDE(b, beta) )                               -- η = e^( -b/β )
			VAR t    = VALUE( SELECTEDVALUE( Miesiace[Miesiace] ) )            -- czas/okres (miesiące)
			VAR x    = DIVIDE( t, eta )                                        -- t / η
			VAR Z_HIGH = 700.0                                                 -- progi stabilności
			VAR Z_LOW  = -700.0
			RETURN
			IF(
			    ISBLANK(beta) || ISBLANK(b) || ISBLANK(t) || beta = 0,
			    BLANK(),
			    IF(
			        x <= 0,
			        0,
			        VAR z = beta * LN( x )                                     -- ln( (t/η)^β )
			        VAR cdf =
			            IF( z > Z_HIGH, 1.0,
			                IF( z < Z_LOW, 0.0,
			                    1 - EXP( - EXP( z ) )                          -- 1 - exp( - (t/η)^β )
			                )
			            )
			        RETURN
			            cdf
			
			// VAR a = MAX('gold zapotrzebowanie_na_czesci'[a (wsp. kierunkowy)])
			// VAR b = MAX('gold zapotrzebowanie_na_czesci'[b (wyraz wolny)])
			// VAR ln2 = LN(2.0)
			// VAR z = a * ln2 + b
			// VAR Z_HIGH = 700.0   -- próg przeciwko overflow exp(z)
			// VAR Z_LOW  = -700.0  -- próg przeciwko underflow exp(z)
			// RETURN
			// IF(
			//     ISBLANK(a) || ISBLANK(b) || NOT(ISNUMBER(a)) || NOT(ISNUMBER(b)),
			//     BLANK(),
			//     IF(
			//         z > Z_HIGH, 1.0,
			//         IF(
			//             z < Z_LOW, 0.0,
			//             1 - EXP( - EXP( z ) )
			//         )
			//     )
			// )
			))
		lineageTag: d9ba867e-9aa4-429d-8ef9-659760b8c715

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Zapotrzebowanie na częsci2' = ```
			
			VAR beta = MAX('gold zapotrzebowanie_na_czesci'[a (wsp. kierunkowy)])
			VAR b    = MAX('gold zapotrzebowanie_na_czesci'[b (wyraz wolny)])
			VAR eta  = EXP( - DIVIDE(b, beta) )                               -- η = e^( -b/β )
			VAR t    = VALUE( SELECTEDVALUE( Miesiace[Miesiace] ) )            -- czas/okres (miesiące)
			VAR x    = DIVIDE( t, eta )                                        -- t / η
			VAR Z_HIGH = 700.0                                                 -- progi stabilności
			VAR Z_LOW  = -700.0
			RETURN
			IF(
			    ISBLANK(beta) || ISBLANK(b) || ISBLANK(t) || beta = 0,
			    BLANK(),
			    IF(
			        x <= 0,
			        0,
			        VAR z = beta * LN( x )                                     -- ln( (t/η)^β )
			        VAR cdf =
			            IF( z > Z_HIGH, 1.0,
			                IF( z < Z_LOW, 0.0,
			                    1 - EXP( - EXP( z ) )                          -- 1 - exp( - (t/η)^β )
			                )
			            )
			        RETURN
			            cdf *
			            [Awaryjność] *
			            MAX('gold zapotrzebowanie_na_czesci'[Sold_quantity])
			    )
			)
			
			```
		lineageTag: bd583956-383e-4d00-83d1-73c70abbfbcd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

