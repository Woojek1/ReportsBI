			measure _ProfitAmountItem_CurrentMonth_Previous_Year = ```
					
					VAR _PreviousYear  = YEAR(TODAY())-1
					VAR _CurrentMonth = MONTH(TODAY())
					
					VAR _SalesAmountLCY =
					                    CALCULATE(
					                        SUM('invoices'[AmountLCY]),
					                        'Invoices'[Type] = "Towar" || Invoices[Type] = "Towar (Korekta)",
					                        FILTER(
					                            ALL('Calendar'),
					                            AND(Calendar[Year] = _PreviousYear,
					                                Calendar[MonthNumber] = _CurrentMonth
					                            )
					                        )
					                    )
					                    
					VAR _Costs =
					            CALCULATE(
					                SUM('Invoices'[Koszt skorygowany]),
					                'Invoices'[Type] = "Towar" || Invoices[Type] = "Towar (Korekta)",
					                FILTER(
					                    ALL('Calendar'),
					                    AND(Calendar[Year] = _PreviousYear,
					                        Calendar[MonthNumber] = _CurrentMonth
					                    )
					                )
					            )
					
					VAR _ProfitLCY = 
					             _SalesAmountLCY - _Costs
					
					
					RETURN
					_ProfitLCY
					
					
					
					```
