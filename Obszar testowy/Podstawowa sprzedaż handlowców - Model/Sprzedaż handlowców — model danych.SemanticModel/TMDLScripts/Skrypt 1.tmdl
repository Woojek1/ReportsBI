				formatString: #,0
				displayFolder: Sales
				lineageTag: ae3d4b1c-fa27-4d49-9b25-3ca16a0fc50d

				annotation PBI_FormatHint = {"isDecimal":true}

			measure DistinctInvoiceCount =
					
