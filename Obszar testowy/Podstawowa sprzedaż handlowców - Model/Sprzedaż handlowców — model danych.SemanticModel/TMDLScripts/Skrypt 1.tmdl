					                SUM(Invoices[ProfitLCY]),
					                        'Invoices'[Type] = "Towar" ||
					                        Invoices[Type] = "Towar (Korekta)"
					            )            
					
					VAR Margin = 
					        DIVIDE(_ProfitLCY, _SalesAmountLCY)
					
					
					RETURN Margin
					
					```
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Sales
				lineageTag: 78e4d0d7-dcc3-465f-868a-ae92faf3cabc

			measure MarginItems_MTD_Today = ```
					
					VAR _SalesAmountLCY = 
					                    CALCULATE(
					                        TOTALMTD(
					                            SUM('invoices'[AmountLCY]),
					                            'Calendar'[Date]
					                        ),
					                        'Calendar'[Date] = TODAY(),
					                        'Invoices'[Type] = "Towar" || 'invoices'[Type] = "Towar (Korekta)"
					    )
					
					VAR _Costs = 
					            CALCULATE(
					                TOTALMTD(
					                    SUM('Invoices'[Koszt skorygowany]),
					                    'Calendar'[Date]
					                ),
					                'Calendar'[Date] = TODAY(),
					                'Invoices'[Type] = "Towar" || 'invoices'[Type] = "Towar (Korekta)"
					            )
					
					
					VAR _ProfitLCY = 
					            _SalesAmountLCY - _Costs   
					
					RETURN
					    DIVIDE(
					            _ProfitLCY,
					            _SalesAmountLCY
					    )
					
					
					
					```
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Sales
				lineageTag: 539626a7-4335-4770-912e-4baf3eacc858

			measure MarginItems_MTD_Today_Previous_Year = ```
					
					VAR _SalesAmountLCY = 
					                    CALCULATE(
					                    TOTALMTD(
					                        SUM('invoices'[AmountLCY]),
					                        'Calendar'[Date]
					                    ),
					                    SAMEPERIODLASTYEAR('Calendar'[Date]),
					                    'Invoices'[Type] = "Towar"
					                    )
					VAR _Profit = 
					            CALCULATE(
					            TOTALMTD(
					                SUM('Invoices'[ProfitLCY]),
					                'Calendar'[Date]
					            ),
					            SAMEPERIODLASTYEAR('Calendar'[Date]),
					            'Invoices'[Type] = "Towar"
					            )           
					
					RETURN
					    DIVIDE(
					            _Profit,
					            _SalesAmountLCY
					    )
					
					
					```
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Sales
				lineageTag: 011d05b7-b1fa-40ee-a5ec-4099ccc24e8b

