	partition Calendar_Payment = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDARAUTO(),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "YearMonth", FORMAT([Date], "YYYYMM"),
				    "MonthNumber", MONTH([Date]),
				    "MonthName", FORMAT([Date], "MMMM"),
				    "Day", DAY([Date])
				)
				
				```

	annotation PBI_Id = 8586f851cb0a40aab421566f8cf19424

